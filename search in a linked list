 #You are given a Singly Linked List of integers with a head pointer. Every node of the Linked List has a value written on it.

int searchInLinkedList(Node<int> *head, int k) {
     Node<int>* temp = head;
    while(temp != nullptr) {
        if(temp->data == k)
            return 1;
        temp = temp->next;
    }
    return 0;
}
